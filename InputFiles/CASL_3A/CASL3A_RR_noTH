!!
!! CASL Benchmark 3A
!! A 3D assembly with detailed spacer grids
!!

type randomRayPhysicsPackage;

pop      75000;
active   200;
inactive  100;
dead       40;
termination 440;
plot 0;
cache 1;
XSdata   mg;
dataType mg;
outputFile CASL3A;
!printFlux 1 ;
lin 0;

power 1.734e7; !60kW per pin, also used in the coupling tally as norm

! NEED TO CHANGE MAP Z DIMENSIONS
fluxMap {type multiMap;
            maps (xax yax zax);
            xax { type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 17;}
            yax { type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 17;}
            zax { type spaceMap; axis z; grid lin; min -200.0; max 200.0; N 20;}
}

powerMap {type multiMap;
            maps (xax yax zax);
            xax { type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 17;}
            yax { type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 17;}
            zax { type spaceMap; axis z; grid lin; min -200.0; max 200.0; N 20;}
}

tally{}

coupling {
        receiveFile commIn;
        sendFile commOut;
        outputFile outputF;
        updateFreq 1;
        maxIt 50;
        tally {
            fissionMap {
                type rayClerk;
                map {
                    type multiMap;
                    maps (xax yax zax);

                    xax { type spaceMap; axis x; grid lin; min -10.71; max 10.71; N 17;}
                    yax { type spaceMap; axis y; grid lin; min -10.71; max 10.71; N 17;}
                    zax { type spaceMap; axis z; grid lin; min -200.0; max 200.0; N 20;}
                }

                response (fiss);

                fiss {
                    type macroResponse;
                    MT -6;
                }
            }
            totalFiss {type rayClerk; response (fiss); fiss {type macroResponse; MT -6;}}
            norm totalFiss;
            normVal 1.734e7;
        }

        fieldPaths (tempFile);
        fieldNames (temperature);
}


temperature {type cartesianField;
             origin  (0 0 0);
             shape   (17 17 20);
             pitch   (1.26 1.26 20.0);
             materials (fuel coolant);
			 fuel       ()            ;
			 coolant    ()            ;
			 default -1.0;
}


