type randomRayPhysicsPackage;

pop      10000;
active   200;
inactive  200;
dead       20;
termination 220;
plot 0;
cache 1;
XSdata   mg;
dataType mg;
outputFile thermalPinOut;
printFlux 1 ;

power 60000; !60kW per pin

fissionMap {type multiMap;
            maps (xax yax zax);
            xax { type spaceMap; axis x; grid lin; min -0.63; max 0.63; N 1;}
            yax { type spaceMap; axis y; grid lin; min -0.63; max 0.63; N 1;}
            zax { type spaceMap; axis z; grid lin; min -200.0; max 200.0; N 20;}
}
fluxMap {type multiMap;
            maps (xax yax zax);
            xax { type spaceMap; axis x; grid lin; min -0.63; max 0.63; N 1;}
            yax { type spaceMap; axis y; grid lin; min -0.63; max 0.63; N 1;}
            zax { type spaceMap; axis z; grid lin; min -200.0; max 200.0; N 20;}
}

powerMap {type multiMap;
            maps (xax yax zax);
            xax { type spaceMap; axis x; grid lin; min -0.63; max 0.63; N 1;}
            yax { type spaceMap; axis y; grid lin; min -0.63; max 0.63; N 1;}
            zax { type spaceMap; axis z; grid lin; min -200.0; max 200.0; N 20;}
}

!coupling {
!	receiveFile ;
!	sendFile ;
!	updateFreq ;
!	maxIt ;
!	tally ;
!	fieldPaths ;
!	fieldNames ;
!}


temperature {type cartesianField;
             origin  (0 0 0);
             shape   (1 1 20);
             pitch   (1.26 1.26 20.0);
             materials (fuel coolant);
             fuel ( 644 715 776 825 863 890 909 921 929 934 936 937 933 926 912 890 857 812 755 686 );
             coolant ( 569 570 572 574 576 578 581 584 586 589 592 594 597 600 602 604 606 608 609 610 );
             default -1.0;
}

geometry {
    type geometryStd;
    boundary (1 1 1 1 0 0);
    graph {type extended;}

    surfaces {
          squareBound        { id 3; type box; origin (0.0 0.0 0.0); halfwidth (0.63 0.63 200.0);}
    }


    cells
    {
    }

    universes
    {
      
      pin { id 2; type pinUniverse; radii (0.54 0.0); fills (fuel coolant);}


      root
      {
          id 1;
          type rootUniverse;
          border 3; 
          fill u<4>;
      }

    fuellattice{
      id 4;
      type latUniverse;
      pitch (1.260 1.260 20.0);
      shape (1 1 20);
      padMat void;
      map (
	     2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2
          );
    }
    }
}
nuclearData {
  handles { 
    mg { type baseMgNeutronDatabase; PN P0;} 
  } 


materials {
   
    fuel {
      temp (600 800 1000);
      coldFile UO2Low;
      medFile UO2Med;
      hotFile UO2High;
      composition { }
   }

    coolant {
      temp (500 600 700);
      coldFile moderLow;
      medFile moderMed;
      hotFile moderHigh;
      composition { }
   }



}

}
